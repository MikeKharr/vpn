# Caddy хоста th2: страница имени cdn2.zpq.ai и его сертификат.
# Решение — ADR 2026-10-05-2223 (раздел «Индексация, блокировка, взлом, SEO»).
# Образец — блок cdn.zpq.ai:8444 в MikeKharr/zpq-ai, deploy/Caddyfile.
#
# Два слушателя, и оба нужны по разным причинам:
#   :80  — опубликован наружу на 160.236.128.28. По нему идёт ACME HTTP-01
#          (решатель Caddy стоит ДО маршрутов любого сервера) и редирект на
#          https, как у любого хоста статики. Без явного блока `http://`
#          автоматический редирект Caddy для сайта на нестандартном порту
#          повёл бы на https://cdn2.zpq.ai:8444, а снаружи 8444 не
#          существует.
#   :8444 — НЕ опубликован. Это `target` REALITY (XRAY_TARGET в
#          hosts/th2/compose.yml): сюда Xray пробрасывает неаутентифицированный
#          зонд, и страница ниже — ровно то, что зонд видит. Отдельный
#          слушатель, а не общий вход, потому что на общем входе клиент VPN
#          достал бы все имена машины (блокирующая к ADR zpq-ai
#          2026-10-03-1544).
#
# Что лежит в `cdn/` и чего там нет — объясняется ЗДЕСЬ, а не в самом файле:
# `cdn/index.html` отдаётся наружу байт в байт, и комментарий в нём читал бы
# любой, кто откроет исходник страницы. В файле только то, что носил бы
# обычный хост статики, плюс одна строка `<meta name="build-id"
# content="cdn2-zpq-ai-static">` — метка, по которой проверка выкатки отличает
# нашу страницу от чужого 200; по форме это идентификатор сборки, которым она
# и является. Держит это `.github/scripts/mask-page-guard.sh`: в файлах
# `deploy/hosts/th2/cdn/` не должно быть ни HTML-комментариев, ни слов,
# называющих назначение имени или внутренний порт.
{
	# Адрес для уведомлений Let's Encrypt об истечении сертификата. Тот же,
	# что у cdn.zpq.ai: зона одна, и почта у владельца одна.
	email admin@zpq.ai

	# `protocols h1 h2` — БЕЗ h3, и это не вкус (ADR 2026-10-05-2223,
	# таблица, строка «Блокировка»). С умолчанием Caddy анонсирует HTTP/3
	# заголовком `alt-svc: h3=":8444"`, то есть называет зонду ВНУТРЕННИЙ
	# порт, которого снаружи нет. Так сегодня у cdn.zpq.ai — живой заголовок
	# проверен владельцем 2026-10-05; там это чинится отдельно, в своём
	# репозитории.
	#
	# `servers :8444`, а не `servers` без адреса: alt-svc шлёт сервер TLS, и
	# ровно у него это и снимается. У :80 умолчания не трогаются — туда
	# приходит ACME HTTP-01, и менять там протоколы незачем.
	#
	# `strict_sni_host on` закрывает подмену Host зондом: запрос с SNI
	# cdn2.zpq.ai и чужим Host получает 421, а не страницу. Сам он включается
	# только при клиентской аутентификации, которой здесь нет, поэтому задан
	# явно. Цена: запрос по IP без SNI получает 421 вместо страницы по
	# умолчанию — для `target` REALITY это ровно то, что нужно.
	servers :8444 {
		protocols h1 h2
		strict_sni_host on
	}

	# Журнал по умолчанию не пишет НИКУДА: личный VPN, и список обращений к
	# маске — это адреса и User-Agent'ы зондов, то есть новый поток данных
	# третьих лиц при границе 7 AGENTS.md («журналов обращений нет»).
	# В вывод контейнера пишет отдельный логгер по списку РАЗРЕШЕНИЙ:
	# `tls` — выпуск и обслуживание сертификата, `admin` — загрузка
	# конфигурации. Ни одно пространство, несущее адрес запроса, сюда не
	# входит: ни `http.log.*`, ни `http.handlers.*`.
	# Форма — не `include` у самого `default`: Caddy отвергает конфигурацию,
	# где у одного логгера непустые и `include`, и `exclude`, а `exclude` у
	# `default` адаптер дописывает сам, как только в файле появляется
	# именованный логгер (разбор — zpq-ai, deploy/Caddyfile).
	log default {
		output discard
	}

	log ops {
		include admin tls
		output stderr
		format json
	}
}

cdn2.zpq.ai:8444 {
	# Сертификат выпускается ТОЛЬКО по HTTP-01, через опубликованный :80.
	#
	# Почему это не перестраховка: TLS-ALPN-01 Let's Encrypt проверяет
	# соединением на порт 443 ИМЕНИ, а 443 этой машины держит Xray — Caddy
	# там не слушает вовсе (публикация у него одна,
	# `160.236.128.28:80:80`). Дойдёт ли такая проверка до слушателя :8444
	# пробросом зонда REALITY — вопрос без гарантии: путь зависит от того,
	# как REALITY обходится с ALPN `acme-tls/1` у неаутентифицированного
	# соединения. Выпуск сертификата на это не опирается.
	#
	# Чем плохо умолчание: адаптер Caddyfile сам TLS-ALPN не выключает ни на
	# каком порту сайта (caddy v2.11.0,
	# caddyconfig/httpcaddyfile/tlsapp.go, `fillInGlobalACMEDefaults` — в нём
	# трогается только `alternate_port`; проверено по исходнику). То есть без
	# этой строки certmagic пробовал бы TLS-ALPN-01 первым, и каждая попытка
	# — отказ авторизации у Let's Encrypt, лимит на которые отдельный от
	# лимита выпусков.
	#
	# Адрес уведомлений (`email` в глобальном блоке) к этому issuer'у
	# применяется: тот же `fillInGlobalACMEDefaults` дописывает глобальный
	# email любому ACME-issuer'у, у которого он пуст. Второй раз здесь он
	# поэтому не стоит.
	#
	# Держит `.github/scripts/mask-listener-guard.sh` (проверка 6) на выводе
	# `caddy adapt`: у каждого ACME-issuer'а `challenges["tls-alpn"].disabled`
	# обязан быть `true`.
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}

	# Записей об обращениях нет — причина в глобальном блоке выше. Директива
	# стоит и здесь: она не даёт записям появиться, если у проекта когда-нибудь
	# завёдется логгер по умолчанию.
	log_skip

	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server

		# Требование владельца 2026-10-05 («закрой от индексации»).
		# Заголовок, а не только robots.txt: robots.txt просит не ХОДИТЬ, а
		# этот заголовок запрещает ИНДЕКСИРОВАТЬ уже полученный ответ — в том
		# числе когда адрес пришёл роботу ссылкой, а не обходом. Два разных
		# канала, поэтому стоят оба; требует ОБА шаг ci.yml «Страница маски
		# th2 ничего не выдаёт и закрыта от роботов».
		# Мета-тега в cdn/index.html намеренно НЕТ: третий носитель того же
		# запрета ничего не добавляет, а в отдаваемый файл добавил бы строку,
		# которой у обычного хоста статики не бывает.
		# Поимённых записей для ИИ-ботов тоже нет: `*` их покрывает, а
		# перечень на «хосте статики» — примета (ADR, таблица).
		X-Robots-Tag "noindex, nofollow"
	}

	root * /srv/cdn
	file_server
}

# Порт 80 имени. Блок обязателен, а не для красоты: он снимает автоматический
# редирект на :8444 (см. шапку). Сам ACME HTTP-01 этот блок не перехватывает —
# решатель Caddy стоит до маршрутов.
http://cdn2.zpq.ai {
	log_skip

	redir https://cdn2.zpq.ai{uri} permanent
}
