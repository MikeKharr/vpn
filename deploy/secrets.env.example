# Образец deploy/secrets.env. Настоящий файл живёт ТОЛЬКО на сервере, его
# кладёт владелец скриптом deploy/put-secrets.sh (chmod 600). В репозитории
# его нет и быть не может: .gitignore плюс шаг CI «Секреты не попали в
# репозиторий».
#
# Значения владелец получает у себя (ADR 2026-10-03-0353, «Ручные шаги», п. 4):
#   docker run --rm ghcr.io/xtls/xray-core:26.9.30 x25519
#   uuidgen            — по одному на устройство
#   openssl rand -hex 4 — по одному на устройство
#
# ЭТИ ТРИ КОМАНДЫ — ТОЛЬКО ДЛЯ ПЕРВОЙ УСТАНОВКИ СЕРВЕРА, у которого клиента
# ещё нет. Для th2 пара УЖЕ СУЩЕСТВУЕТ, и `x25519` для него запускать НЕЛЬЗЯ:
# публичная половина уже уехала в импортированный профиль Happ на оба
# устройства, и новая пара сделала бы th2 недостижимым для клиента, а починка
# требовала бы переимпорта при лежащем VPN (ADR 2026-10-06-1054, п. 3).
# `uuidgen` и `openssl rand` для th2 тоже не запускаются: UUID и shortId —
# ТЕ ЖЕ, что на th1.
#
# Формы проверяет deploy/render/render.sh и отказывает со своим кодом, если
# значение не той формы.

# PrivateKey из вывода `xray x25519`: 43 знака base64url.
# ДЛЯ th2 — ровно из ~/.config/vpn/th2-reality.key, а не из нового запуска
# `x25519` (выше). Как перенести значение в приглашение put-secrets.sh, не
# напечатав его: README, «Как положить его на th2, не напечатав».
REALITY_PRIVATE_KEY=<43-znaka-base64url>

# UUID устройств: вывод uuidgen, разные.
UUID_MAC=<uuid-ustroystva-mac>
UUID_IPHONE=<uuid-ustroystva-iphone>

# shortId устройств: 8 знаков hex в нижнем регистре, разные.
SHORTID_MAC=<8-hex>
SHORTID_IPHONE=<8-hex>

# XRAY_TARGET здесь НЕТ намеренно. Это не секрет, а строка межрепозиторного
# контракта, и она живёт в environment службы render в deploy/compose.yml, где
# её видно в диффе и где её держит шаг CI. В этом файле у неё не было ни одного
# держателя: значение набирал руками владелец, и опечатка проходила и проверку
# формы, и `xray run -test`, и выкатку (находка reviewer).
